# ==============================================================================
# DeepFake Audio Analyzer — Backend Environment Configuration Template
# Copy this file to '.env' and populate with your local/deployment credentials.
# IMPORTANT: Never commit actual passwords or production secrets to version control.
# ==============================================================================

# ========================
# Server Configuration
# ========================
PORT=5000
NODE_ENV=development

# ========================
# PostgreSQL Database
# ========================
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password
DB_NAME=deepfake_db
DATABASE_URL=postgresql://your_postgres_user:your_postgres_password@localhost:5432/deepfake_db

# ========================
# JWT Authentication
# ========================
JWT_SECRET=your_secure_random_jwt_secret_key_min_32_characters
JWT_EXPIRES_IN=7d

# ========================
# File Upload Settings
# ========================
# Maximum file size in bytes (50MB = 52428800)
MAX_FILE_SIZE=52428800
# Allowed audio MIME types (comma-separated)
ALLOWED_MIME_TYPES=audio/wav,audio/mpeg,audio/mp3,audio/flac,audio/ogg,audio/x-wav,audio/x-flac
# Upload storage directory (relative to backend root)
UPLOAD_DIR=uploads

# ========================
# Logging
# ========================
LOG_LEVEL=info
LOG_DIR=logs

# ========================
# Rate Limiting
# ========================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# ========================
# CORS (Cross-Origin Resource Sharing)
# ========================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ========================
# AI / ML Model Configuration
# ========================
# Model inference engine: 'trained' (production ensemble) or 'mock' (development fallback)
AI_MODEL_TYPE=trained
# Python executable path (must have librosa, scikit-learn, soundfile installed)
PYTHON_PATH=python
